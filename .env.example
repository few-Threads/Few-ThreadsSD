# MongoDB connection string. Optional locally (falls back to an in-memory DB), REQUIRED on Vercel.
MONGODB_URI=
# Secret used to sign login tokens. Use a long random string in production.
JWT_SECRET=
# Local API port
PORT=5000
# Only needed if the frontend and API live on different domains. Leave unset on Vercel.
VITE_API_URL=
# At least one AI key enables the AI features (users can also paste their own key in the app)
GEMINI_API_KEY=
GROQ_API_KEY=
# Extra allowed CORS origins, comma-separated (e.g. a custom domain if the API is called cross-origin)
CORS_ORIGINS=
